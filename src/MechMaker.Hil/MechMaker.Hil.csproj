<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241108" />
    <!-- Linux ships the same natives for containers/CI (the win package covers
         desktop builds; the loader picks the right native per OS). The linux
         runtime release lags the win one; same 4.10 ABI. -->
    <PackageReference Include="OpenCvSharp4.runtime.linux-x64" Version="4.10.0.20240717" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MechMaker.Engine\MechMaker.Engine.csproj" />
    <ProjectReference Include="..\MechMaker.Core\MechMaker.Core.csproj" />
  </ItemGroup>

</Project>
