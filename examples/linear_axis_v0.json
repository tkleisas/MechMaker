{
  "schema_version": "0.1",
  "name": "linear_axis_v0",
  "description": "Minimal belt-driven linear axis: two motors with GT2 pulleys belt-coupled, an MGN12 rail on a 2020 beam, a carriage carrying an endstop.",
  "parts": [
    { "id": "beam", "part": "beam_2020_400", "pose": { "pos": [0, 0, 0] } },
    { "id": "rail", "part": "mgn12_rail_400", "pose": {} },
    { "id": "carriage", "part": "mgn12_carriage", "pose": {} },
    { "id": "motor_left", "part": "nema17_stepper", "pose": {} },
    { "id": "motor_right", "part": "nema17_stepper", "pose": {} },
    { "id": "motor_plate_left", "part": "motor_mount_plate_2020", "pose": {} },
    { "id": "motor_plate_right", "part": "motor_mount_plate_2020", "pose": {} },
    { "id": "pulley_left", "part": "gt2_pulley_20t", "pose": {} },
    { "id": "pulley_right", "part": "gt2_pulley_20t", "pose": {} },
    { "id": "belt", "part": "gt2_belt_400", "pose": { "pos": [0, 0, 0] } },
    { "id": "endstop", "part": "endstop_microswitch", "pose": {} }
  ],
  "connections": [
    { "id": "rail_on_beam", "part_a": "beam", "connector_a": "top_mid", "part_b": "rail", "connector_b": "mount" },
    { "id": "carriage_on_rail", "part_a": "rail", "connector_a": "carriage_top", "part_b": "carriage", "connector_b": "rail_side" },
    { "id": "motor_plate_left_on_beam", "part_a": "beam", "connector_a": "end_a", "part_b": "motor_plate_left", "connector_b": "tslot" },
    { "id": "motor_left_on_plate", "part_a": "motor_plate_left", "connector_a": "motor_face", "part_b": "motor_left", "connector_b": "mount" },
    { "id": "motor_plate_right_on_beam", "part_a": "beam", "connector_a": "end_b", "part_b": "motor_plate_right", "connector_b": "tslot" },
    { "id": "motor_right_on_plate", "part_a": "motor_plate_right", "connector_a": "motor_face", "part_b": "motor_right", "connector_b": "mount" },
    { "id": "pulley_left_on_shaft", "part_a": "motor_left", "connector_a": "shaft", "part_b": "pulley_left", "connector_b": "bore" },
    { "id": "pulley_right_on_shaft", "part_a": "motor_right", "connector_a": "shaft", "part_b": "pulley_right", "connector_b": "bore" },
    { "id": "belt_left", "part_a": "belt", "connector_a": "end_a", "part_b": "pulley_left", "connector_b": "belt" },
    { "id": "belt_right", "part_a": "belt", "connector_a": "end_b", "part_b": "pulley_right", "connector_b": "belt" },
    { "id": "belt_clamp", "part_a": "carriage", "connector_a": "belt_clamp", "part_b": "belt", "connector_b": "clamp" },
    { "id": "endstop_on_carriage", "part_a": "carriage", "connector_a": "top", "part_b": "endstop", "connector_b": "mount" }
  ],
  "boards": [
    {
      "id": "main",
      "type": "skr-pico",
      "pins": {
        "x_step": "P2_2", "x_dir": "P2_6", "x_en": "P2_1",
        "y_step": "P6_2", "y_dir": "P6_6", "y_en": "P6_1",
        "endstop_x": "P1_28"
      }
    }
  ],
  "wiring": [
    { "component": "motor_left", "signal": "step", "board": "main", "pin": "P2_2" },
    { "component": "motor_left", "signal": "dir", "board": "main", "pin": "P2_6" },
    { "component": "motor_left", "signal": "enable", "board": "main", "pin": "P2_1" },
    { "component": "motor_right", "signal": "step", "board": "main", "pin": "P6_2" },
    { "component": "motor_right", "signal": "dir", "board": "main", "pin": "P6_6" },
    { "component": "motor_right", "signal": "enable", "board": "main", "pin": "P6_1" },
    { "component": "endstop", "signal": "endstop", "board": "main", "pin": "P1_28" }
  ]
}
