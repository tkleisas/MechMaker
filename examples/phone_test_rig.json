{
  "schema_version": "0.1",
  "name": "phone_test_rig",
  "description": "The androidtester seed rig, minimal: an android_phone on a plate at the beam centre, and a touch_finger hanging under a plate on the side, arming over the phone with a horizontal arm. The tip hangs on a servo-driven slide (the press plunger): command it down (set_finger_position) and when it presses the glass the HIL bridge dispatches emulator taps at the contact point.",
  "parts": [
    { "id": "base", "part": "beam_2020_400", "pose": { "pos": [0, 0, 0] } },
    { "id": "phone_plate", "part": "motor_mount_plate_2020", "pose": {} },
    { "id": "dut", "part": "android_phone", "pose": {} },
    { "id": "finger_plate", "part": "motor_mount_plate_2020", "pose": {} },
    { "id": "finger", "part": "touch_finger", "pose": {} }
  ],
  "connections": [
    { "id": "phone_plate_on_base", "part_a": "base", "connector_a": "top_mid", "part_b": "phone_plate", "connector_b": "tslot" },
    { "id": "phone_on_plate", "part_a": "phone_plate", "connector_a": "motor_face", "part_b": "dut", "connector_b": "nest" },
    { "id": "finger_plate_on_base", "part_a": "base", "connector_a": "top_a", "part_b": "finger_plate", "connector_b": "tslot" },
    { "id": "finger_on_plate", "part_a": "finger_plate", "connector_a": "motor_face", "part_b": "finger", "connector_b": "mount" }
  ],
  "boards": [
    { "id": "main", "type": "skr-pico" }
  ],
  "wiring": [
    { "component": "finger", "signal": "pwm", "board": "main", "pin": "P2_2" }
  ]
}